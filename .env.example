# Server-only. Never use NEXT_PUBLIC_ for these.
# Local dev (Django on host): http://192.168.3.45:9900
# Docker Compose: http://backend:8000
BACKEND_URL=http://192.168.3.45:9900

# Absolute paths to PEM files used by the BFF crypto helpers
LOGIN_PUBLIC_KEY_PATH=/absolute/path/to/public_key_client.pem
RESPONSE_PRIVATE_KEY_PATH=/absolute/path/to/private_key.pem

# Docker image listens on 3050 (see Dockerfile / docker-compose haas-client service)
PORT=3050

# Shared staff session cookie with dashboard-clone. Use false on HTTP (LAN IP).
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

# Live dashboard origin for the header "Live dashboard" button
NEXT_PUBLIC_LIVE_DASHBOARD_URL=http://192.168.3.45:3002

# Shared NFS / media root (same as user-blue-team). Team image view reads from here.
DJ_MEDIA_ROOT=/mnt/shared/uploads
# UPLOADS_PATH=/mnt/shared/uploads
